# Example of /etc/nxblogger/nxblogger.env (install.sh creates the real file).
# After editing run: sudo bash /opt/nxblogger/update.sh --force

NXB_SECRET_KEY=change-me-to-a-long-random-string
NXB_DATA_DIR=/var/lib/nxblogger
NXB_ADMIN_USER=admin
NXB_BLOG_TITLE="My Blog"

# Public HTTPS port served by nginx, and the internal gunicorn port (127.0.0.1 only)
NXB_HTTPS_PORT=8800
NXB_APP_PORT=8801

# DNS name and Let's Encrypt
NXB_DOMAIN=blog.example.com
NXB_LE_EMAIL=
NXB_LETSENCRYPT=1

NXB_TIMEZONE=Europe/Helsinki
NXB_COOKIE_SECURE=1
NXB_BEHIND_PROXY=1
NXB_MAX_UPLOAD_MB=200
NXB_MAX_IMAGE_MB=25
NXB_GUNICORN_WORKERS=2
