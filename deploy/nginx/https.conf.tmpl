# NXBlogger – generated by install.sh / update.sh from deploy/nginx/*.tmpl.
# Do not edit here; change the template in the repository instead.
server {
    listen @@HTTPS_PORT@@ ssl http2;
    listen [::]:@@HTTPS_PORT@@ ssl http2;
    server_name @@SERVER_NAME@@;

    ssl_certificate     @@SSL_DIR@@/fullchain.pem;
    ssl_certificate_key @@SSL_DIR@@/privkey.pem;
    ssl_protocols TLSv1.2 TLSv1.3;
    ssl_prefer_server_ciphers off;
    ssl_session_cache shared:nxb_ssl:10m;
    ssl_session_timeout 1d;

    # Plain http:// sent to the https port -> redirect to https://
    error_page 497 =301 https://$host:$server_port$request_uri;

    client_max_body_size @@MAX_UPLOAD_MB@@m;

    access_log /var/log/nginx/nxblogger.access.log;
    error_log  /var/log/nginx/nxblogger.error.log;

    location /static/ {
        alias @@DATA_DIR@@/static/;
        expires 7d;
        access_log off;
    }

    location /uploads/ {
        alias @@DATA_DIR@@/uploads/;
        expires 30d;
        add_header X-Content-Type-Options nosniff;
        add_header Content-Security-Policy "default-src 'none'; img-src 'self'; media-src 'self'; style-src 'unsafe-inline'";
        access_log off;
    }

    location = /favicon.ico {
        alias @@DATA_DIR@@/static/favicon.svg;
        default_type image/svg+xml;
        access_log off;
    }

    location / {
        proxy_pass http://127.0.0.1:@@APP_PORT@@;
        proxy_set_header Host $http_host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto https;
        proxy_set_header X-Forwarded-Host $host;
        proxy_set_header X-Forwarded-Port $server_port;
        proxy_read_timeout 300s;
        proxy_send_timeout 300s;
    }
}
